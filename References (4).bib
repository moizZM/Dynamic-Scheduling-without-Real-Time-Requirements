@book{Ha2017,
  editor    = {Soonhoi Ha and J{\"u}rgen Teich},
  title     = {Handbook of Hardware/Software Codesign},
  publisher = {Springer},
  year      = {2017},
  note      = {This source provided the foundational distinctions between static and dynamic scheduling, and emphasized model-based design using data-flow models (like CDFG). It helped define key concepts in scheduling flexibility and analyzability trade-offs, central to my seminar.}
}

@book{Scheffer2016,
  editor    = {Louis Scheffer and Luciano Lavagno and Grant E. Martin and Igor L. Markov},
  title     = {Electronic Design Automation for IC System Design, Verification, and Testing (2nd ed.)},
  publisher = {CRC Press},
  year      = {2016},
  note      = {Used for insights into scheduling techniques in multimedia processors, especially under quasi-static and hybrid approaches. It helped contextualize dynamic scheduling in real-world EDA tools and systems without hard real-time requirements.}
}

@book{DeMicheli1994,
  author    = {Giovanni De Micheli},
  title     = {Synthesis and Optimization of Digital Circuits},
  publisher = {McGraw-Hill},
  year      = {1994},
  note      = {This source offered the theoretical basis for scheduling, including sequencing graphs and relative scheduling equations. It supported my explanation of control dependencies and run-time flexibility in hardware implementations.}
}

@phdthesis{Rettberg2006,
  author    = {Achim Rettberg},
  title     = {Low Power Driven High-Level Synthesis for Dedicated Architectures},
  school    = {University of Paderborn},
  year      = {2006},
  note      = {Supported my discussion on power-aware dynamic scheduling by introducing the concept of mobility-based operation grouping. It also contributed a real-world example (MACT architecture) relevant to self-timed dynamic HLS pipelines.}
}
